{
  // Independent Cloudflare deployment. Never reuse Noah's KV IDs or tokens.
  "name": "lake-george-703-plan",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    { "binding": "KV", "id": "4ff1ca37eda74b478e6141e33b9d43c4" }
  ],
  "triggers": { "crons": ["*/20 * * * *"] },
  "vars": { "SINGLE_PROFILE": "1" },
  // Keep dashboard-set non-secret variables during GitHub deployments.
  "keep_vars": true,
  // Fail deploy if either of these secure Cloudflare bindings is missing.
  // The VALUES remain stored only in Cloudflare and are never committed.
  "secrets": { "required": ["PASSCODE", "DATA_KEY"] }
}
