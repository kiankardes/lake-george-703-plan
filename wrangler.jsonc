{
  // Independent Cloudflare deployment. Never reuse Noah's KV IDs or tokens.
  "name": "lake-george-703-plan",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    { "binding": "KV", "id": "4ff1ca37eda74b478e6141e33b9d43c4" }
  ],
  "triggers": { "crons": ["*/20 * * * *"] },
  "vars": { "SINGLE_PROFILE": "1" },
  // Stop deploying if the secret bindings are missing; values are stored only in Cloudflare.
  "secrets": { "required": ["PASSCODE", "DATA_KEY"] }
}
