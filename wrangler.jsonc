{
  // Independent Cloudflare deployment. Never reuse Noah's KV IDs or tokens.
  "name": "kian-lake-george-703",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [
    { "binding": "KV", "id": "REPLACE_WITH_YOUR_OWN_KV_NAMESPACE_ID" }
  ],
  "triggers": { "crons": ["*/20 * * * *"] },
  "vars": { "SINGLE_PROFILE": "1" }
}
